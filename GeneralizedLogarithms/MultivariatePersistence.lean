import GeneralizedLogarithms.MultivariateMultiplicity
import LogIrrationalityMeasure.Jets.DerivativeIdeals

/-!
# Persistent prime components for the multivariate differential frame

The generic derivative-ideal machinery is applied to the actual multivariate
polynomial frame. The initial prime, its height bound, and the vanishing of
bounded words there remain explicit inputs. For the interpolation argument the
stage increment `δ` can be taken to be `ε * N`; no curve containment or height
statement is assumed to have been proved by this module.
-/

namespace GeneralizedLogarithms
namespace MultivariatePersistence

noncomputable section

open LogIrrationalityMeasure.LogExponent
open MultivariatePolynomialFrame MultivariateMultiplicity

section GenericWords

variable {R ι : Type*} [CommRing R] [Algebra ℚ R]

/-- The generic ideal construction and the Taylor construction use the same words. -/
theorem wordDerivative_eq_derivationWord (D : ι → Derivation ℚ R R)
    (word : List ι) (f : R) :
    DerivativeIdeals.wordDerivative D word f = derivationWord D word f := by
  induction word with
  | nil => rfl
  | cons i word ih =>
    simp only [DerivativeIdeals.wordDerivative_cons, derivationWord, ih]

theorem wordCost_eq (cost : ι → ℝ) (word : List ι) :
    DerivativeIdeals.wordCost cost word = MultivariateMultiplicity.wordCost cost word := rfl

end GenericWords

variable {C : Type*} [Field C] [CharZero C] {k m : ℕ}

/-- The equations are indexed by all words within the prescribed cost budget. -/
def BoundedWords (cost : (Fin k ⊕ Fin m) → ℝ) (bound : ℝ) :=
  {word : List (Fin k ⊕ Fin m) // MultivariateMultiplicity.wordCost cost word ≤ bound}

/-- The bounded frame derivatives of a polynomial. -/
def equations (a : Fin m → Fin k → C) (cost : (Fin k ⊕ Fin m) → ℝ)
    (bound : ℝ) (F : Polynomial C k m) : BoundedWords cost bound → Polynomial C k m :=
  fun word => frameWord a word.val F

/-- The ideal generated by all derivatives within the given cost budget. -/
def derivativeIdeal (a : Fin m → Fin k → C) (cost : (Fin k ⊕ Fin m) → ℝ)
    (bound : ℝ) (F : Polynomial C k m) : Ideal (Polynomial C k m) :=
  DerivativeIdeals.derivativeIdeal (rationalFrame a) cost bound F

theorem wordDerivative_eq_frameWord (a : Fin m → Fin k → C)
    (word : List (Fin k ⊕ Fin m)) (F : Polynomial C k m) :
    DerivativeIdeals.wordDerivative (rationalFrame a) word F = frameWord a word F :=
  wordDerivative_eq_derivationWord _ _ _

/-- The explicit equation family generates precisely the derivative ideal. -/
theorem span_equations (a : Fin m → Fin k → C) (cost : (Fin k ⊕ Fin m) → ℝ)
    (bound : ℝ) (F : Polynomial C k m) :
    Ideal.span (Set.range (equations a cost bound F)) = derivativeIdeal a cost bound F := by
  unfold derivativeIdeal DerivativeIdeals.derivativeIdeal
  apply congrArg Ideal.span
  ext g
  constructor
  · rintro ⟨word, rfl⟩
    exact ⟨word.val, word.property, wordDerivative_eq_frameWord a word.val F⟩
  · rintro ⟨word, hw, hword⟩
    refine ⟨⟨word, hw⟩, ?_⟩
    exact (wordDerivative_eq_frameWord a word F).symm.trans hword

theorem self_mem_derivativeIdeal (a : Fin m → Fin k → C)
    (cost : (Fin k ⊕ Fin m) → ℝ) (bound : ℝ) (F : Polynomial C k m)
    (hbound : 0 ≤ bound) : F ∈ derivativeIdeal a cost bound F :=
  DerivativeIdeals.self_mem_derivativeIdeal (rationalFrame a) cost bound F hbound

theorem derivativeIdeal_mono (a : Fin m → Fin k → C)
    (cost : (Fin k ⊕ Fin m) → ℝ) (F : Polynomial C k m)
    {s t : ℝ} (hst : s ≤ t) :
    derivativeIdeal a cost s F ≤ derivativeIdeal a cost t F :=
  DerivativeIdeals.derivativeIdeal_mono (rationalFrame a) cost F hst

/-- Containment of a derivative ideal is equivalent to vanishing of its bounded words. -/
theorem derivativeIdeal_le_iff (a : Fin m → Fin k → C)
    (cost : (Fin k ⊕ Fin m) → ℝ) (bound : ℝ) (F : Polynomial C k m)
    (Q : Ideal (Polynomial C k m)) :
    derivativeIdeal a cost bound F ≤ Q ↔
      ∀ word, MultivariateMultiplicity.wordCost cost word ≤ bound → frameWord a word F ∈ Q := by
  constructor
  · intro h word hw
    rw [← wordDerivative_eq_frameWord]
    exact h (DerivativeIdeals.word_mem_derivativeIdeal (rationalFrame a) cost bound F word hw)
  · intro h
    apply Ideal.span_le.mpr
    rintro g ⟨word, hw, rfl⟩
    rw [wordDerivative_eq_frameWord]
    exact h word hw

/-- Every bounded word applied to any member of the current ideal belongs to
the next containing ideal. This is stronger than checking only its generators. -/
theorem frameWord_mem_of_next_stage (a : Fin m → Fin k → C)
    (cost : (Fin k ⊕ Fin m) → ℝ) (hcost : ∀ i, 0 ≤ cost i)
    (bound δ : ℝ) (F g : Polynomial C k m) (Q : Ideal (Polynomial C k m))
    (hg : g ∈ derivativeIdeal a cost bound F)
    (hnext : derivativeIdeal a cost (bound + δ) F ≤ Q)
    (word : List (Fin k ⊕ Fin m)) (hw : MultivariateMultiplicity.wordCost cost word ≤ δ) :
    frameWord a word g ∈ Q := by
  rw [← wordDerivative_eq_frameWord]
  exact DerivativeIdeals.derivative_vanishes_on_persistent_ideal
    (rationalFrame a) cost hcost bound δ F g Q hg hnext word hw

/-- The preceding membership statement is actual vanishing in the prime residue field. -/
theorem frameWord_residue_eq_zero_of_next_stage (a : Fin m → Fin k → C)
    (cost : (Fin k ⊕ Fin m) → ℝ) (hcost : ∀ i, 0 ≤ cost i)
    (bound δ : ℝ) (F g : Polynomial C k m) (Q : Ideal (Polynomial C k m)) [Q.IsPrime]
    (hg : g ∈ derivativeIdeal a cost bound F)
    (hnext : derivativeIdeal a cost (bound + δ) F ≤ Q)
    (word : List (Fin k ⊕ Fin m)) (hw : MultivariateMultiplicity.wordCost cost word ≤ δ) :
    primeResidueMap Q (frameWord a word g) = 0 := by
  apply Ideal.algebraMap_residueField_eq_zero.mpr
  exact frameWord_mem_of_next_stage a cost hcost bound δ F g Q hg hnext word hw

/-- A nonzero initial polynomial yields a persistent, nonzero prime of positive
height. The ambient prime containment and height cap are assumptions. With
`δ = ε * N`, the required initial word budget is `(h + 2) * (ε * N)`. -/
theorem exists_persistent_prime (a : Fin m → Fin k → C)
    (cost : (Fin k ⊕ Fin m) → ℝ) (hcost : ∀ i, 0 ≤ cost i)
    (δ : ℝ) (hδ : 0 ≤ δ) (F : Polynomial C k m) (hF : F ≠ 0)
    (h : ℕ) (P : Ideal (Polynomial C k m)) (hP : P.IsPrime) (hheight : P.height ≤ h)
    (hvanish : ∀ word : List (Fin k ⊕ Fin m),
      MultivariateMultiplicity.wordCost cost word ≤ ((h : ℝ) + 2) * δ →
      frameWord a word F ∈ P) :
    ∃ r < h + 2, ∃ Q : Ideal (Polynomial C k m),
      Q.IsPrime ∧ Q ≠ ⊥ ∧
      Q ∈ (derivativeIdeal a cost ((r : ℝ) * δ) F).minimalPrimes ∧
      Q ∈ (derivativeIdeal a cost (((r : ℝ) + 1) * δ) F).minimalPrimes ∧
      Q ≤ P ∧ 1 ≤ Q.height ∧ Q.height ≤ h ∧
      ∀ g ∈ derivativeIdeal a cost ((r : ℝ) * δ) F,
        ∀ word : List (Fin k ⊕ Fin m), MultivariateMultiplicity.wordCost cost word ≤ δ →
          frameWord a word g ∈ Q := by
  have hvanish' : ∀ word : List (Fin k ⊕ Fin m),
      DerivativeIdeals.wordCost cost word ≤ ((h : ℝ) + 2) * δ →
      DerivativeIdeals.wordDerivative (rationalFrame a) word F ∈ P := by
    intro word hw
    rw [wordDerivative_eq_frameWord]
    exact hvanish word hw
  obtain ⟨r, hr, Q, hQr, hQnext, hQP, hQlo, hQhi, hwords⟩ :=
    DerivativeIdeals.exists_persistent_derivative_component
      (rationalFrame a) cost hcost δ hδ F hF h P hP hheight hvanish'
  have hQne : Q ≠ ⊥ := by
    intro hQzero
    have hFQ : F ∈ Q := hQr.le
      (self_mem_derivativeIdeal a cost ((r : ℝ) * δ) F
        (mul_nonneg (Nat.cast_nonneg r) hδ))
    exact hF (by simpa only [hQzero, Ideal.mem_bot] using hFQ)
  refine ⟨r, hr, Q, hQr.isPrime, hQne, hQr, hQnext, hQP, hQlo, hQhi, ?_⟩
  intro g hg word hw
  rw [← wordDerivative_eq_frameWord]
  exact hwords g hg word hw

end
end MultivariatePersistence
end GeneralizedLogarithms

