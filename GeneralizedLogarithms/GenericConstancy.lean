import GeneralizedLogarithms.MultivariateFrame
import GeneralizedLogarithms.MonomialDifferential
import GeneralizedLogarithms.GenericConormal

/-!
# From generic normal-basis rigidity to constancy

The tangent subspace is generated by the coordinate evaluations of all
function-field derivations. Mandatory transverse frame columns force
logarithmic identities for these derivations. The algebraic obstruction then
makes the corresponding monomials and additive coordinates constant.

The universal multiplicity comparison is still an explicit hypothesis. This
file does not construct the persistent geometric component or prove that
comparison for it.
-/

namespace GeneralizedLogarithms
namespace GenericConstancy

noncomputable section

open scoped BigOperators
open LogIrrationalityMeasure.LogExponent.NormalBasisRigidity

variable {C E : Type*} [Field C] [CharZero C] [IsAlgClosed C]
  [Field E] [Algebra C E] [Algebra.EssFiniteType C E]
  {k m : ℕ}

/-- The coordinate tangent vector of a scalar-valued function-field derivation. -/
def derivationCoordinates (y : Fin k → E) (x : Fin m → E)
    (δ : Derivation C E E) : (Fin k ⊕ Fin m) → E :=
  Sum.elim (fun r => δ (y r)) (fun i => δ (x i))

/-- The generic coordinate tangent subspace defined using all derivations. -/
def derivationTangent (y : Fin k → E) (x : Fin m → E) :
    Submodule E ((Fin k ⊕ Fin m) → E) :=
  Submodule.span E (Set.range (derivationCoordinates (C := C) y x))

omit [CharZero C] [IsAlgClosed C] [Algebra.EssFiniteType C E] in
theorem derivationCoordinates_mem (y : Fin k → E) (x : Fin m → E)
    (δ : Derivation C E E) :
    derivationCoordinates y x δ ∈ derivationTangent (C := C) y x :=
  Submodule.subset_span ⟨δ, rfl⟩

/-- Coordinate directions in the normal quotient. -/
def coordinateNormalFamily (y : Fin k → E) (x : Fin m → E)
    (j : Fin k ⊕ Fin m) :=
  (derivationTangent (C := C) y x).mkQ (Pi.basisFun E _ j)

/-- Logarithmic frame directions in the same normal quotient. -/
def frameNormalFamily (a : Fin m → Fin k → ℤ) (y : Fin k → E)
    (hy : ∀ r, y r ≠ 0) (x : Fin m → E) (j : Fin k ⊕ Fin m) :=
  (derivationTangent (C := C) y x).mkQ
    (MultivariateFrame.frameBasis (fun i r => (a i r : E)) y hy j)

/-- A mandatory frame column forces both associated functions to be constant. -/
theorem constants_of_mandatory_normal_direction
    (a : Fin m → Fin k → ℤ) (y : Fin k → E) (hy : ∀ r, y r ≠ 0)
    (x : Fin m → E) (i : Fin m)
    (hi : ∀ B, IsNormalBasis (K := E) (frameNormalFamily (C := C) a y hy x) B →
      Sum.inr i ∈ B) :
    (∃ c : C, algebraMap C E c = ∏ r, y r ^ a i r) ∧
      ∃ b : C, algebraMap C E b = x i := by
  apply constants_of_monomial_derivation_relation Finset.univ y hy (a i) (x i)
  intro δ
  have h := MultivariateFrame.tangent_subspace_logarithmic_relation
    (fun i r => (a i r : E)) y hy (derivationTangent (C := C) y x) i hi
    (derivationCoordinates y x δ) (derivationCoordinates_mem y x δ)
  simpa only [derivationCoordinates, Sum.elim_inr, Sum.elim_inl] using h

omit [CharZero C] [IsAlgClosed C] [Algebra.EssFiniteType C E] in
/-- A constant additive coordinate vanishes on all generic tangent vectors,
not only on individual derivation evaluations. -/
theorem tangent_coordinate_eq_zero_of_constant
    (y : Fin k → E) (x : Fin m → E) (i : Fin m)
    (hc : ∃ c : C, algebraMap C E c = x i)
    (t : (Fin k ⊕ Fin m) → E) (ht : t ∈ derivationTangent (C := C) y x) :
    t (Sum.inr i) = 0 := by
  have hle : derivationTangent (C := C) y x ≤
      LinearMap.ker (LinearMap.proj (Sum.inr i)) := by
    apply Submodule.span_le.mpr
    rintro _ ⟨δ, rfl⟩
    change δ (x i) = 0
    obtain ⟨c, hc⟩ := hc
    rw [← hc]
    simp
  exact hle ht

/-- Distinct mandatory transverse directions, with one nonzero exponent row,
force a strict dimension gap in the normal quotient. Constancy and vanishing
of the required covectors are derived inside the proof. -/
theorem mandatory_directions_codimension_gap
    {I : Type*} [Fintype I] (e : I ↪ Fin m) (i₀ : I)
    (a : Fin m → Fin k → ℤ) (y : Fin k → E) (hy : ∀ r, y r ≠ 0)
    (x : Fin m → E) (ha : a (e i₀) ≠ 0)
    (hmandatory : ∀ i : I, ∀ B,
      IsNormalBasis (K := E) (frameNormalFamily (C := C) a y hy x) B →
        Sum.inr (e i) ∈ B) :
    Fintype.card I + 1 ≤ Module.finrank E
      (((Fin k ⊕ Fin m) → E) ⧸ derivationTangent (C := C) y x) := by
  let : CharZero E := Algebra.charZero_of_charZero C E
  have hconstant : ∀ i : I, ∃ c : C, algebraMap C E c = x (e i) := fun i =>
    (constants_of_mandatory_normal_direction a y hy x (e i) (hmandatory i)).2
  have hX : ∀ i : I, ∀ t ∈ derivationTangent (C := C) y x,
      t (Sum.inr (e i)) = 0 := fun i t ht =>
    tangent_coordinate_eq_zero_of_constant y x (e i) (hconstant i) t ht
  apply GenericConormal.coordinate_card_add_one_le_of_logarithmic_relation
    (derivationTangent (C := C) y x) e i₀ (a (e i₀)) ha y hy hX
  intro t ht
  exact MultivariateFrame.tangent_subspace_logarithmic_relation
    (fun i r => (a i r : E)) y hy (derivationTangent (C := C) y x)
    (e i₀) (hmandatory i₀) t ht

/-- The generic constancy part of the normal-space argument, now composed from
weighted rigidity, the actual multivariate frame, and the residue obstruction.
All basis comparisons and weight separation remain explicit inputs. -/
theorem weighted_generic_constancy [frameOrder : LinearOrder (Fin k ⊕ Fin m)]
    (a : Fin m → Fin k → ℤ) (y : Fin k → E) (hy : ∀ r, y r ≠ 0)
    (x : Fin m → E) (w cost : (Fin k ⊕ Fin m) → ℝ) (bound : ℕ → ℝ)
    (hcomparison : ∀ A B,
      IsNormalBasis (K := E) (coordinateNormalFamily (C := C) y x) A →
      IsNormalBasis (K := E) (frameNormalFamily (C := C) a y hy x) B →
      (∏ j ∈ A, w j) ≤ bound A.card * ∏ j ∈ B, cost j)
    (hseparated : ∀ A B : Finset (Fin k ⊕ Fin m), A.card = B.card →
      ∀ i : Fin m, Sum.inr i ∈ A → Sum.inr i ∉ B →
      (∀ j : Fin m, frameOrder.lt (Sum.inr i) (Sum.inr j) →
        (Sum.inr j ∈ A ↔ Sum.inr j ∈ B)) →
      bound A.card * (∏ j ∈ B, cost j) < ∏ j ∈ A, w j) :
    ∃ I : Finset (Fin k ⊕ Fin m),
      IsGreedyBasis (K := E) (coordinateNormalFamily (C := C) y x)
        (Finset.univ.image Sum.inr) I ∧
      (∀ B, IsNormalBasis (K := E) (frameNormalFamily (C := C) a y hy x) B →
        B ∩ Finset.univ.image Sum.inr = I) ∧
      ∀ i : Fin m, Sum.inr i ∈ I →
        (∃ c : C, algebraMap C E c = ∏ r, y r ^ a i r) ∧
          ∃ b : C, algebraMap C E b = x i := by
  obtain ⟨I, hI, hfixed, _⟩ := MultivariateFrame.weighted_tangent_relations
    (fun i r => (a i r : E)) y hy (derivationTangent (C := C) y x)
    w cost bound hcomparison hseparated
  refine ⟨I, hI, hfixed, ?_⟩
  intro i hi
  apply constants_of_mandatory_normal_direction a y hy x i
  intro B hB
  have hmem : Sum.inr i ∈ B ∩ Finset.univ.image Sum.inr := by
    rw [hfixed B hB]
    exact hi
  exact (Finset.mem_inter.mp hmem).1

/-- If the exponent rows span every longitudinal direction, constancy of their
monomials forces every longitudinal coordinate to be constant. This is the
full-rank branch of the generic normal-space argument. The spanning hypothesis
must eventually be obtained from the selected general-position rows. -/
theorem longitudinal_constants_of_spanning_rows
    {s : ℕ} (a : Fin s → Fin k → ℤ) (y : Fin k → E) (hy : ∀ r, y r ≠ 0)
    (hspan : Submodule.span E (Set.range (fun i r => (a i r : E))) = ⊤)
    (hconstant : ∀ i, ∃ c : C, algebraMap C E c = ∏ r, y r ^ a i r) :
    ∀ r, ∃ c : C, algebraMap C E c = y r := by
  have hzero : ∀ δ : Derivation C E E, ∀ r, δ (y r) = 0 := by
    intro δ r
    let f : (Fin k → E) →ₗ[E] E :=
      Fintype.linearCombination E (fun j => δ (y j) / y j)
    have hker : Submodule.span E (Set.range (fun i r => (a i r : E))) ≤
        LinearMap.ker f := by
      apply Submodule.span_le.mpr
      rintro _ ⟨i, rfl⟩
      obtain ⟨c, hc⟩ := hconstant i
      have hm := logarithmic_derivation_monomial δ Finset.univ y hy (a i)
      rw [← hc] at hm
      change f (fun r => (a i r : E)) = 0
      simpa [f, Fintype.linearCombination_apply, div_eq_mul_inv, mul_comm] using hm.symm
    have hfr : f (Pi.single r 1) = 0 := hker (by rw [hspan]; trivial)
    have hr : δ (y r) / y r = 0 := by
      simpa [f, Fintype.linearCombination_apply, Pi.single_apply] using hfr
    simpa [hy r] using hr
  intro r
  have hD : KaehlerDifferential.D C E (y r) = 0 := by
    apply (Module.forall_dual_apply_eq_zero_iff E _).mp
    intro φ
    exact hzero (φ.compDer (KaehlerDifferential.D C E)) r
  exact LogIrrationalityMeasure.LogExponent.constant_of_logarithmic_differential
    (0 : E) (y r) (by simp [hD])

end
end GenericConstancy
end GeneralizedLogarithms

/-- info: 'GeneralizedLogarithms.GenericConstancy.constants_of_mandatory_normal_direction' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms GeneralizedLogarithms.GenericConstancy.constants_of_mandatory_normal_direction

